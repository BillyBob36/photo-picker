{
  "name": "photo-picker-poc",
  "version": "0.1.0",
  "description": "Outil isolé : extraction des photos Google Maps des salons + UI de tri (swipe/grille + crop) + push automatique du hero choisi vers outil-coiffure. Rollback : rm -rf photo-picker-poc/.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "import": "node scripts/import-csv.mjs",
    "batch": "node scripts/run-batch.mjs",
    "reset": "node scripts/reset-db.mjs",
    "poc": "node scripts/extract-photos.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "csv-parse": "^5.5.6",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "puppeteer": "^23.0.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sharp": "^0.33.5"
  }
}
