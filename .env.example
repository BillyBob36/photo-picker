# --- photo-picker-poc config ---
# Copier vers .env (auto-loaded par Node si on lance avec --env-file=.env).

# Port du serveur
PORT=4000

# Mot de passe unique pour accéder à l'UI (login simple : un seul "compte")
PICKER_PASSWORD=changeme-en-prod

# Secret pour signer le cookie de session (générer avec : openssl rand -hex 32)
SESSION_SECRET=remplace-moi-en-prod-32-chars-minimum

# Base outil-coiffure : chemin vers le fichier SQLite (lecture pour mapper FID->slug,
# écriture pour mettre à jour overrides_json.hero.backgroundImage).
# Dev local Windows :   ../outil-coiffure/data/salons.db   (n'existe pas tant que pas migré)
# Prod Coolify (volume partagé) : /data/salons.db
OUTIL_DB_PATH=../outil-coiffure/data/salons.db

# Dossier où on dépose les hero crops finaux. Outil-coiffure le servira sur /hero-images/{slug}.jpg.
# Doit être lisible par outil-coiffure (= même volume).
HERO_IMAGES_DIR=../outil-coiffure/data/hero-images

# Dossier des screenshots de outil-coiffure (on overwrite après recapture).
SCREENSHOTS_DIR=../outil-coiffure/data/screenshots

# URL publique d'un landing salon (pour la recapture screenshot après changement de hero).
# Le slug du salon est suffixé à cette URL : ${SITE_PUBLIC_URL}/preview/{slug}
SITE_PUBLIC_URL=https://monsitehq.com

# Concurrence des navigateurs Puppeteer pour le batch d'extraction
SCRAPE_CONCURRENCY=4
SCRAPE_DELAY_MS=2000
